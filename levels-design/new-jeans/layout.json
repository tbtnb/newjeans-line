 "sections": [
  {
   "t": 0,
   "label": "Intro · 方格纸",
   "palette": {
    "skyTop": "#E7F7FD"
   },
   "camera": "iso",
   "note": "open blank plan; long straight + one big L; side slabs flip up on the first percussion"
  },
  {
   "t": 7.511,
   "label": "Beat in · 蓝图线",
   "camera": "iso",
   "note": "switchbacks on the 2-step snares; first buildings unfold from the plan"
  },
  {
   "t": 14.675,
   "label": "Verse 1 · 纸片房屋",
   "camera": "iso",
   "note": "the line wraps round the Bunny Gate, then an open U through the courtyard; two rows of blocks rise between vocal phrases"
  },
  {
   "t": 36.168,
   "label": "Chorus 1 · 五色尾迹",
   "palette": {
    "skyTop": "#AEE3F7",
    "particles": "pixels"
   },
   "camera": "wide",
   "note": "L1 (+4): horseshoe of staircases round the sunken city courtyard; five flight fins rise one by one on the hook accents"
  },
  {
   "t": 50.496,
   "label": "Break · 像素平面",
   "palette": {
    "skyTop": "#D3EEF9",
    "particles": null
   },
   "camera": "high",
   "note": "drop to L0 and run UNDER the chorus deck; tall blocks retract, the fins cast the bunny shadow (E1)"
  },
  {
   "t": 57.66,
   "label": "Rebuild · 重新立起",
   "camera": "iso",
   "note": "the city re-rises block by block on the kicks"
  },
  {
   "t": 64.825,
   "label": "Verse 2 · 立体城市",
   "camera": "side",
   "note": "four-fold offset alley, then a square spiral up the courtyard tower to L1"
  },
  {
   "t": 86.317,
   "label": "Chorus 2 · 飞行",
   "palette": {
    "skyTop": "#9FDDF5",
    "particles": "pixels"
   },
   "camera": "wide",
   "note": "climb to L2 (+8): big offset staircases above the whole city; fins open outward like pages; pixel billboard far away"
  },
  {
   "t": 100.645,
   "label": "Outro · 牛仔徽章",
   "palette": {
    "skyTop": "#CFEFFB",
    "lightIntensity": 1.0
   },
   "camera": "high",
   "note": "one elbow, long finish straight on L2; the five trails freeze into the cover tableau"
  }
