 "sections": [
  {
   "t": 0,
   "label": "Intro riff",
   "note": "01 L0 sparse start deck; taps sit on the synth-riff beats (about one per beat), long breathing straights. P1: four roof slabs rise on the four-count."
  },
  {
   "t": 19.452,
   "label": "Verse 1",
   "note": "02 locker canyon, L0, closed: staggered lockers on both sides; the moombah/dembow kick-snare (3+3+2) drives syncopated 16th-offset turns.",
   "palette": {
    "fogEnd": 90
   }
  },
  {
   "t": 38.652,
   "label": "Pre-chorus 1",
   "note": "03 R1 ramp L0->L1 (+3), walls fold outward (P2); sparse call-and-response vocal taps.",
   "palette": {
    "fogEnd": 130
   }
  },
  {
   "t": 48.252,
   "label": "Build 1",
   "note": "03 end: kick build, pool fully revealed before the chorus."
  },
  {
   "t": 53.052,
   "label": "Chorus 1",
   "note": "04 pool, L1, open U around the pool (SW dip / SE run / NE climb). P3 back panels unfold, five colour dance pillars answer the vocal.",
   "palette": {
    "skyTop": "#86C3EA",
    "ground": "#BFE6EE"
   }
  },
  {
   "t": 72.252,
   "label": "Post-chorus 1",
   "note": "04 exit CP1, B1 flat bridge heading SE towards the sports court."
  },
  {
   "t": 91.452,
   "label": "Verse 2",
   "note": "05 sports court U (NE up, SE across, SW down) around the court with red-white goal; P4 goal and low walls rise.",
   "palette": {
    "fogEnd": 110
   }
  },
  {
   "t": 115.452,
   "label": "Pre-chorus 2",
   "note": "06 phone patio: closed single corridor of phone-shaped screens; E1 flip phone silently flips open on the outer shelf.",
   "palette": {
    "fogEnd": 85,
    "skyTop": "#A9CBE8"
   }
  },
  {
   "t": 125.052,
   "label": "Build 2",
   "note": "07 bridge B2/R2: deck unfolds early (P6), ramp L1->L2 (+3)."
  },
  {
   "t": 129.852,
   "label": "Chorus 2",
   "note": "07 long SW bridge run up to L2, CP2 at the end; road narrows to 2.0.",
   "palette": {
    "skyTop": "#B9B8EE",
    "ground": "#DCDDF5"
   }
  },
  {
   "t": 149.052,
   "label": "Final chorus",
   "note": "08 L2 sky dance: NW run with two syncopated SW offsets (asymmetric horseshoe steps); panels open in canon (P7), pillars return. Road 1.9.",
   "palette": {
    "skyTop": "#C8C3F0",
    "skyBottom": "#F5F2FB"
   }
  },
  {
   "t": 170.652,
   "label": "Outro",
   "note": "09 calm straight to the finish deck, little white bunny echo; P8 cover freeze.",
   "palette": {
    "skyTop": "#AFC9EE"
   }
  }
